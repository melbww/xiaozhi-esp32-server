    {
      "id": "part2_nD",
      "type": "text",
      "x": 1130,
      "y": 2030,
      "width": 1100,
      "height": 160,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
