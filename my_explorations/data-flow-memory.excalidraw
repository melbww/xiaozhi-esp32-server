      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Only the API branch reaches MySQL: manager-api re-reads\nai_agent_chat_history by sessionId (why conf must be 1/2).\nquery_memory() is a RAM read — no DB mid-conversation.\nNext connect pushes summary_memory back into the config.",
      "roughness": 1,
      "roundness": null,
      "seed": 277658064,
      "strokeColor": "#495057",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Only the API branch reaches MySQL: manager-api re-reads\nai_agent_chat_history by sessionId (why conf must be 1/2).\nquery_memory() is a RAM read — no DB mid-conversation.\nNext connect pushes summary_memory back into the config.",
      "textAlign": "left",
      "updated": 1794759226505,
      "version": 1,
      "versionNonce": 40726442,
      "verticalAlign": "top"
    },
